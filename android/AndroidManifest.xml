<?xml version="1.0" encoding="utf-8"?>
<!-- Raypass for Android: an external Sol app (app id "raypass", scope "feeds"). It talks to Sol's
     loopback API over plain HTTP on 127.0.0.1 only (network_security_config), keeps no backups
     (allowBackup=false: the cache is ciphertext, but the token is not), and provides an
     AutofillService. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.raypass">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 11+ package visibility: without this, Sol is invisible to us and CONNECT fails as
         if Sol were not installed. -->
    <queries>
        <package android:name="app.sol" />
        <intent>
            <action android:name="app.sol.action.CONNECT" />
        </intent>
    </queries>
    <application
        android:name=".RaypassApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Raypass">
        <!-- configChanges: the screens are built in code with no per-orientation resources, and
             recreating them would drop a typed master password, an unlock in progress or an
             unsaved edit (views made in code have no ids, so Android cannot restore them). -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ItemActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".EditActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".GeneratorActivity" android:exported="false" android:label="@string/generator"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <!-- Exported: Android's autofill settings open it (autofill_service.xml settingsActivity). -->
        <activity android:name=".SettingsActivity" android:exported="true" android:label="@string/settings"
            android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".AutofillAuthActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/Theme.Raypass.Dialog" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <!-- The autofill picker ("Search Raypass"): opened only through the autofill framework's
             authentication intent, never by other apps. -->
        <activity android:name=".AutofillPickActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/Theme.Raypass.Dialog" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <service android:name=".RaypassAutofillService" android:exported="true" android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
